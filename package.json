{
  "name": "coach-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Coach portal v1: a small hosted app where an owner and a coach run a coaching engagement.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check:dashes": "node scripts/check-em-dash.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.6",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
